import os

def image_audit():

    db = audit.db

    images = db.query(PageImage).all()

    if not images:

        audit.fail_test(
            "Images Exist",
            "No images found"
        )
        return

    audit.pass_test(
        "Images Exist",
        str(len(images))
    )

    missing_path = []
    bad_width = []
    bad_height = []
    bad_dpi = []

    duplicate_paths = {}
    duplicates = []

    for img in images:

        if img.page is None:
            audit.fail_test(
                "Image FK -> Page",
                str(img.id)
            )

        path = (img.image_path or "").strip()

        if path == "":
            missing_path.append(str(img.id))

        duplicate_paths[path] = duplicate_paths.get(path, 0) + 1

        if img.width is not None and img.width <= 0:
            bad_width.append(str(img.id))

        if img.height is not None and img.height <= 0:
            bad_height.append(str(img.id))

        if img.dpi is not None and img.dpi <= 0:
            bad_dpi.append(str(img.id))

    for p,c in duplicate_paths.items():

        if p and c > 1:

            duplicates.append(
                f"{p} ({c})"
            )

    if missing_path:

        audit.fail_test(
            "Image Path",
            "\n".join(missing_path)
        )

    else:

        audit.pass_test(
            "Image Path"
        )

    if bad_width:

        audit.fail_test(
            "Image Width",
            "\n".join(bad_width)
        )

    else:

        audit.pass_test(
            "Image Width"
        )

    if bad_height:

        audit.fail_test(
            "Image Height",
            "\n".join(bad_height)
        )

    else:

        audit.pass_test(
            "Image Height"
        )

    if bad_dpi:

        audit.warning(
            "Image DPI",
            "\n".join(bad_dpi)
        )

    else:

        audit.pass_test(
            "Image DPI"
        )

    if duplicates:

        audit.warning(
            "Duplicate Image Paths",
            "\n".join(duplicates)
        )

    else:

