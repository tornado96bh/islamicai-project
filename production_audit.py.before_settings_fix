def bbox_audit():

    db = audit.db

    elements = db.query(PageElement).all()

    if not elements:

        audit.fail_test(
            "Bounding Boxes",
            "No elements found"
        )
        return

    negative = 0
    zero_size = 0
    reversed_box = 0
    valid = 0
    missing = 0

    widths = []
    heights = []

    for e in elements:

        try:

            x1 = e.x1
            y1 = e.y1
            x2 = e.x2
            y2 = e.y2

        except Exception:

            missing += 1
            continue

        if None in (x1, y1, x2, y2):

            missing += 1
            continue

        if x1 < 0 or y1 < 0 or x2 < 0 or y2 < 0:

            negative += 1

        if x2 <= x1 or y2 <= y1:

            reversed_box += 1
            continue

        w = x2 - x1
        h = y2 - y1

        widths.append(w)
        heights.append(h)

        if w == 0 or h == 0:

            zero_size += 1

        valid += 1

    if missing == 0:

        audit.pass_test(
            "Bounding Box Fields"
        )

    else:

        audit.warning(
            "Bounding Box Fields",
            str(missing)
        )

    if negative == 0:

        audit.pass_test(
            "Negative Coordinates"
        )

    else:

        audit.fail_test(
            "Negative Coordinates",
            str(negative)
        )

    if reversed_box == 0:

        audit.pass_test(
            "Reversed Bounding Boxes"
        )

    else:

        audit.fail_test(
            "Reversed Bounding Boxes",
            str(reversed_box)
        )

    if zero_size == 0:

        audit.pass_test(
            "Zero Size Bounding Boxes"
        )

    else:

        audit.fail_test(
            "Zero Size Bounding Boxes",
            str(zero_size)
        )

    if widths:

        audit.pass_test(
            "Average Box Width",
            f"{sum(widths)/len(widths):.2f}"
        )

        audit.pass_test(
            "Minimum Box Width",
            str(min(widths))
        )

        audit.pass_test(
            "Maximum Box Width",
            str(max(widths))
        )

    if heights:

        audit.pass_test(
            "Average Box Height",
            f"{sum(heights)/len(heights):.2f}"
        )

        audit.pass_test(
            "Minimum Box Height",
            str(min(heights))
        )

        audit.pass_test(
            "Maximum Box Height",
            str(max(heights))
        )

    audit.pass_test(
        "Valid Bounding Boxes",
        str(valid)
    )

    audit.pass_test(
        "Bounding Box Audit Finished"
    )

audit.run(
    "Bounding Box Audit",
    bbox_audit
)

