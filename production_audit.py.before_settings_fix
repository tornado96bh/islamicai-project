from collections import Counter

def page_audit():

    db = audit.db

    pages = db.query(Page).all()

    # ----------------------------------------------------
    # Pages Exist
    # ----------------------------------------------------

    if pages:
        audit.pass_test(
            "Pages Exist",
            str(len(pages))
        )
    else:
        audit.fail_test(
            "Pages Exist",
            "No pages found"
        )
        return

    # ----------------------------------------------------
    # Page Number >= 1
    # ----------------------------------------------------

    bad=[]

    for p in pages:

        if p.page_number < 1:

            bad.append(
                str(p.id)
            )

    if bad:

        audit.fail_test(
            "Valid Page Numbers",
            "\n".join(bad)
        )

    else:

        audit.pass_test(
            "Valid Page Numbers"
        )

    # ----------------------------------------------------
    # Duplicate Pages
    # ----------------------------------------------------

    dup=[]

    counter=Counter()

    for p in pages:

        counter[
            (
                p.volume_id,
                p.page_number
            )
        ] +=1

    for k,v in counter.items():

        if v>1:

            dup.append(str(k))

    if dup:

        audit.fail_test(
            "Duplicate Pages",
            "\n".join(dup)
        )

    else:

        audit.pass_test(
            "Duplicate Pages"
        )

    # ----------------------------------------------------
    # Missing Pages
    # ----------------------------------------------------

    missing=[]

    for volume in db.query(Volume).all():

        nums=sorted(
            [
                p.page_number
                for p in volume.pages
            ]
        )

        if not nums:
            continue

        expected=range(
            nums[0],
            nums[-1]+1
        )

        for n in expected:

            if n not in nums:

                missing.append(
                    f'Volume {volume.id} Page {n}'
                )

    if missing:

        audit.fail_test(
            "Missing Pages",
            "\n".join(missing)
        )

    else:

        audit.pass_test(
            "Missing Pages"
        )

    # ----------------------------------------------------
    # Empty Pages
    # ----------------------------------------------------

    empty=[]

    for p in pages:

        if len(p.elements)==0:

            empty.append(
                str(p.page_number)
            )

    if empty:

        audit.fail_test(
            "Pages Without Elements",
            "\n".join(empty)
        )

    else:

        audit.pass_test(
            "Pages Without Elements"
        )

    # ----------------------------------------------------
    # Image Check
    # ----------------------------------------------------

    noimg=[]

    for p in pages:

        if len(p.images)==0:

            noimg.append(
                str(p.page_number)
            )

    if noimg:

        audit.warning(
            "Pages Without Images",
            "\n".join(noimg)
        )

    else:

        audit.pass_test(
            "Pages Without Images"
        )

    # ----------------------------------------------------
    # OCR Count
    # ----------------------------------------------------

    blank=0

    words=0

    for p in pages:

        for e in p.elements:

            if hasattr(e,"text"):

                t=(e.text or "").strip()

                if t=="":
                    blank+=1
                else:
                    words += len(
                        t.split()
                    )

    audit.pass_test(
        "OCR Statistics",
        f"Blank={blank}  Words={words}"
    )

    # ----------------------------------------------------
    # Average Elements
    # ----------------------------------------------------

    avg=sum(
        len(p.elements)
        for p in pages
    )/len(pages)

    audit.pass_test(
        "Average Elements/Page",
        f"{avg:.2f}"
    )

    # ----------------------------------------------------
    # Average Images
    # ----------------------------------------------------

    avg=sum(
        len(p.images)
        for p in pages
    )/len(pages)

    audit.pass_test(
        "Average Images/Page",
        f"{avg:.2f}"
    )

    # ----------------------------------------------------
    # Largest Page
    # ----------------------------------------------------

    largest=max(
        pages,
        key=lambda p:len(p.elements)
    )

    audit.pass_test(
        "Largest Page",
        f'Page {largest.page_number} ({len(largest.elements)} elements)'
    )

    # ----------------------------------------------------
    # Smallest Page
    # ----------------------------------------------------

    smallest=min(
        pages,
        key=lambda p:len(p.elements)
    )

    audit.pass_test(
        "Smallest Page",
        f'Page {smallest.page_number} ({len(smallest.elements)} elements)'
    )

    audit.pass_test(
        "Page Audit Finished"
    )

audit.run(
    "Page Audit",
    page_audit
)

