# MODULE 4A
# DATA CONSISTENCY AUDIT
# ============================================================

def consistency_audit():

    db = audit.db

    # ----------------------------------------------------
    # Volume.total_pages consistency
    # ----------------------------------------------------

    bad_total = []

    for volume in db.query(Volume).all():

        actual = len(volume.pages)

        if volume.total_pages is not None:

            if actual != volume.total_pages:

                bad_total.append(
                    f"Volume {volume.id}: stored={volume.total_pages} actual={actual}"
                )

    if bad_total:

        audit.fail_test(
            "Volume Total Pages",
            "\n".join(bad_total)
        )

    else:

        audit.pass_test(
            "Volume Total Pages"
        )

    # ----------------------------------------------------
    # element_order duplicates
    # ----------------------------------------------------

    duplicate_orders = []

    for page in db.query(Page).all():

        seen = set()

        for e in sorted(page.elements, key=lambda x: x.element_order):

            if e.element_order in seen:

                duplicate_orders.append(
                    f"Page {page.page_number}: order {e.element_order}"
                )

            seen.add(e.element_order)

    if duplicate_orders:

        audit.fail_test(
            "Duplicate Element Order",
            "\n".join(duplicate_orders)
        )

    else:

        audit.pass_test(
            "Duplicate Element Order"
        )

    # ----------------------------------------------------
    # element_order gaps
    # ----------------------------------------------------

    gaps = []

    for page in db.query(Page).all():

        orders = sorted(
            e.element_order
            for e in page.elements
        )

        if not orders:
            continue

        for expected, actual in enumerate(orders):

            if expected != actual:

                gaps.append(
                    f"Page {page.page_number}"
                )

                break

    if gaps:

        audit.warning(
            "Element Order Sequence",
            "\n".join(gaps)
        )

    else:

        audit.pass_test(
            "Element Order Sequence"
        )

    # ----------------------------------------------------
    # bbox exists for text
    # ----------------------------------------------------

    bbox_missing = []

    for e in db.query(PageElement).all():

        txt = (e.text or "").strip()

        if txt and e.bbox is None:

            bbox_missing.append(str(e.id))

    if bbox_missing:

        audit.warning(
            "Text Without Bounding Box",
            "\n".join(bbox_missing)
        )

    else:

        audit.pass_test(
            "Text Without Bounding Box"
        )

    # ----------------------------------------------------
    # Valid element types
    # ----------------------------------------------------

    valid = {
        "text",
        "image",
        "table",
        "title",
        "header",
        "footer"
    }

    unknown = []

    for e in db.query(PageElement).all():

        if e.element_type not in valid:

            unknown.append(
                e.element_type
            )

    if unknown:

        audit.warning(
            "Unknown Element Types",
            "\n".join(sorted(set(unknown)))
        )

    else:

        audit.pass_test(
            "Unknown Element Types"
        )

    # ----------------------------------------------------
    # Pages containing only images
    # ----------------------------------------------------

    only_images = 0

    for p in db.query(Page).all():

        if len(p.images) > 0 and len(p.elements) == 0:

            only_images += 1

    audit.pass_test(
        "Pages With Only Images",
        str(only_images)
    )

    # ----------------------------------------------------
    # Pages containing only OCR
    # ----------------------------------------------------

    only_text = 0

    for p in db.query(Page).all():

        if len(p.elements) > 0 and len(p.images) == 0:

            only_text += 1

    audit.pass_test(
        "Pages With Only OCR",
        str(only_text)
    )

    # ----------------------------------------------------
    # Empty pages
    # ----------------------------------------------------

    empty = []

    for p in db.query(Page).all():

        if len(p.elements) == 0 and len(p.images) == 0:

            empty.append(
                str(p.page_number)
            )

    if empty:

        audit.fail_test(
            "Completely Empty Pages",
            "\n".join(empty)
        )

    else:

        audit.pass_test(
            "Completely Empty Pages"
        )

    audit.pass_test(
        "Consistency Audit Finished"
    )

audit.run(
    "Consistency Audit",
    consistency_audit
)

