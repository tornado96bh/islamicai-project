import time
from sqlalchemy import text
from packages.core.config import settings

def production_readiness():

    db = audit.db

    # ----------------------------------------------------
    # Database Ping
    # ----------------------------------------------------

    start = time.perf_counter()

    db.execute(
        text("SELECT 1")
    )

    elapsed = (
        time.perf_counter() - start
    ) * 1000

    audit.pass_test(
        "Database Ping",
        f"{elapsed:.2f} ms"
    )

    # ----------------------------------------------------
    # Session Test
    # ----------------------------------------------------

    try:

        db.rollback()

        audit.pass_test(
            "Rollback"
        )

    except Exception as ex:

        audit.fail_test(
            "Rollback",
            str(ex)
        )

    # ----------------------------------------------------
    # CRUD Benchmark
    # ----------------------------------------------------

    start = time.perf_counter()

    db.query(Book).count()
    db.query(Edition).count()
    db.query(Volume).count()
    db.query(Page).count()
    db.query(PageElement).count()
    db.query(PageImage).count()

    elapsed = (
        time.perf_counter() - start
    ) * 1000

    audit.pass_test(
        "Count Benchmark",
        f"{elapsed:.2f} ms"
    )

    # ----------------------------------------------------
    # Timestamp Audit
    # ----------------------------------------------------

    future = 0

    now = datetime.now\(UTC\)

    for model in (
        Book,
        Edition,
        Volume,
        Page,
        PageElement,
        PageImage,
    ):

        for row in db.query(model):

            if row.created_at.replace(tzinfo=None) > now:

                future += 1

    if future:

        audit.warning(
            "Future Timestamps",
            str(future)
        )

    else:

        audit.pass_test(
            "Future Timestamps"
        )

    # ----------------------------------------------------
    # Overall Statistics
    # ----------------------------------------------------

    audit.pass_test(
        "Books",
        str(db.query(Book).count())
    )

    audit.pass_test(
        "Editions",
        str(db.query(Edition).count())
    )

    audit.pass_test(
        "Volumes",
        str(db.query(Volume).count())
    )

    audit.pass_test(
        "Pages",
        str(db.query(Page).count())
    )

    audit.pass_test(
        "Elements",
        str(db.query(PageElement).count())
    )

    audit.pass_test(
        "Images",
        str(db.query(PageImage).count())
    )

    audit.pass_test(
        "Production Readiness Finished"
    )

audit.run(
    "Production Readiness",
    production_readiness
)

