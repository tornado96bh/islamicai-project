from uuid import UUID
from datetime import datetime, UTC

def basemodel_audit():

    db = audit.db

    models = [
        Book,
        Edition,
        Volume,
        Page,
        PageElement,
        PageImage,
    ]

    for model in models:

        rows = db.query(model).all()

        bad_uuid = []
        bad_created = []
        bad_updated = []

        for row in rows:

            if not isinstance(row.id, UUID):

                bad_uuid.append(str(row.id))

            if not isinstance(row.created_at, datetime):

                bad_created.append(str(row.id))

            if not isinstance(row.updated_at, datetime):

                bad_updated.append(str(row.id))

            if row.updated_at < row.created_at:

                audit.fail_test(
                    f"{model.__name__} Timestamp Order",
                    str(row.id)
                )

        if bad_uuid:

            audit.fail_test(
                f"{model.__name__} UUID",
                "\n".join(bad_uuid)
            )

        else:

            audit.pass_test(
                f"{model.__name__} UUID"
            )

        if bad_created:

            audit.fail_test(
                f"{model.__name__} created_at",
                "\n".join(bad_created)
            )

        else:

            audit.pass_test(
                f"{model.__name__} created_at"
            )

        if bad_updated:

            audit.fail_test(
                f"{model.__name__} updated_at",
                "\n".join(bad_updated)
            )

        else:

            audit.pass_test(
                f"{model.__name__} updated_at"
            )

    audit.pass_test(
        "BaseModel Audit Finished"
    )

audit.run(
    "BaseModel Audit",
    basemodel_audit
)

