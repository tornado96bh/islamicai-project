import statistics

def element_audit():

    db = audit.db

    elements = db.query(PageElement).all()

    # ----------------------------------------------------
    # Elements Exist
    # ----------------------------------------------------

    if elements:

        audit.pass_test(
            "Elements Exist",
            str(len(elements))
        )

    else:

        audit.fail_test(
            "Elements Exist",
            "No elements found"
        )

        return

    # ----------------------------------------------------
    # Orphan Elements
    # ----------------------------------------------------

    orphan=[]

    for e in elements:

        if e.page is None:

            orphan.append(str(e.id))

    if orphan:

        audit.fail_test(
            "Orphan Elements",
            "\n".join(orphan)
        )

    else:

        audit.pass_test(
            "Orphan Elements"
        )

    # ----------------------------------------------------
    # Empty OCR
    # ----------------------------------------------------

    empty=[]

    for e in elements:

        txt=(e.text or "").strip()

        if txt=="":

            empty.append(str(e.id))

    if empty:

        audit.warning(
            "Empty OCR",
            f"{len(empty)} empty elements"
        )

    else:

        audit.pass_test(
            "Empty OCR"
        )

    # ----------------------------------------------------
    # Short OCR
    # ----------------------------------------------------

    short=0

    for e in elements:

        txt=(e.text or "").strip()

        if txt and len(txt)<3:

            short+=1

    audit.pass_test(
        "Very Short OCR",
        str(short)
    )

    # ----------------------------------------------------
    # Average Text Length
    # ----------------------------------------------------

    lengths=[]

    for e in elements:

        txt=(e.text or "").strip()

        if txt:

            lengths.append(len(txt))

    if lengths:

        audit.pass_test(
            "Average OCR Length",
            f"{statistics.mean(lengths):.2f}"
        )

    # ----------------------------------------------------
    # Long OCR
    # ----------------------------------------------------

    longest=max(
        lengths
    ) if lengths else 0

    audit.pass_test(
        "Longest OCR",
        str(longest)
    )

    # ----------------------------------------------------
    # Duplicate OCR
    # ----------------------------------------------------

    counter={}

    duplicates=0

    for e in elements:

        txt=(e.text or "").strip()

        if not txt:
            continue

        counter[txt]=counter.get(txt,0)+1

    for v in counter.values():

        if v>10:

            duplicates+=1

    audit.pass_test(
        "Repeated OCR Blocks",
        str(duplicates)
    )

    # ----------------------------------------------------
    # Unicode Validation
    # ----------------------------------------------------

    bad_unicode=[]

    for e in elements:

        txt=(e.text or "")

        try:

            txt.encode("utf-8")

        except Exception:

            bad_unicode.append(str(e.id))

    if bad_unicode:

        audit.fail_test(
            "Unicode Errors",
            "\n".join(bad_unicode)
        )

    else:

        audit.pass_test(
            "Unicode Errors"
        )

    # ----------------------------------------------------
    # Control Characters
    # ----------------------------------------------------

    controls=0

    for e in elements:

        txt=e.text or ""

        for c in txt:

            if ord(c)<32 and c not in "\n\r\t":

                controls+=1

    audit.pass_test(
        "Control Characters",
        str(controls)
    )

    # ----------------------------------------------------
    # Leading Spaces
    # ----------------------------------------------------

    lead=0

    trail=0

    for e in elements:

        txt=e.text or ""

        if txt.startswith(" "):

            lead+=1

        if txt.endswith(" "):

            trail+=1

    audit.pass_test(
        "Leading Spaces",
        str(lead)
    )

    audit.pass_test(
        "Trailing Spaces",
        str(trail)
    )

    # ----------------------------------------------------

    audit.pass_test(
        "Element Audit Finished"
    )

audit.run(
    "Element Audit",
    element_audit
)

