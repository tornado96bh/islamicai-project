import statistics

def quality_audit():

    db = audit.db

    pages = db.query(Page).all()

    if not pages:

        audit.fail_test(
            "Quality Audit",
            "No pages"
        )
        return

    element_counts = []
    image_counts = []
    text_lengths = []

    sparse_pages = []
    dense_pages = []

    for page in pages:

        ec = len(page.elements)
        ic = len(page.images)

        element_counts.append(ec)
        image_counts.append(ic)

        if ec < 3:
            sparse_pages.append(
                f"Page {page.page_number}"
            )

        if ec > 300:
            dense_pages.append(
                f"Page {page.page_number}"
            )

        total_chars = 0

        for e in page.elements:

            txt = (e.text or "").strip()

            total_chars += len(txt)

        text_lengths.append(total_chars)

    audit.pass_test(
        "Average Elements/Page",
        f"{statistics.mean(element_counts):.2f}"
    )

    audit.pass_test(
        "Median Elements/Page",
        f"{statistics.median(element_counts):.2f}"
    )

    audit.pass_test(
        "Maximum Elements/Page",
        str(max(element_counts))
    )

    audit.pass_test(
        "Minimum Elements/Page",
        str(min(element_counts))
    )

    audit.pass_test(
        "Average Images/Page",
        f"{statistics.mean(image_counts):.2f}"
    )

    audit.pass_test(
        "Average Characters/Page",
        f"{statistics.mean(text_lengths):.2f}"
    )

    if sparse_pages:

        audit.warning(
            "Sparse Pages",
            "\n".join(sparse_pages)
        )

    else:

        audit.pass_test(
            "Sparse Pages"
        )

    if dense_pages:

        audit.warning(
            "Dense Pages",
            "\n".join(dense_pages)
        )

    else:

        audit.pass_test(
            "Dense Pages"
        )

    # --------------------------------------------------------
    # Volumes Statistics
    # --------------------------------------------------------

    volume_sizes = []

    for volume in db.query(Volume).all():

        volume_sizes.append(
            len(volume.pages)
        )

    if volume_sizes:

        audit.pass_test(
            "Average Pages/Volume",
            f"{statistics.mean(volume_sizes):.2f}"
        )

        audit.pass_test(
            "Largest Volume",
            str(max(volume_sizes))
        )

        audit.pass_test(
            "Smallest Volume",
            str(min(volume_sizes))
        )

    # --------------------------------------------------------
    # Books Statistics
    # --------------------------------------------------------

    for book in db.query(Book).all():

        page_total = 0

        for edition in book.editions:

            for volume in edition.volumes:

                page_total += len(volume.pages)

        audit.pass_test(
            f"Book '{book.title}' Pages",
            str(page_total)
        )

    audit.pass_test(
        "Quality Audit Finished"
    )

audit.run(
    "Quality Audit",
    quality_audit
)

