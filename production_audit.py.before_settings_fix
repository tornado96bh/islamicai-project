GREEN = "\033[92m"
RED = "\033[91m"
YELLOW = "\033[93m"
RESET = "\033[0m"

@dataclass
class AuditResult:
    name: str
    status: str
    message: str
    elapsed: float

class ProductionAudit:

    def __init__(self):
        self.db = SessionLocal()
        self.results = []
        self.pass_count = 0
        self.fail_count = 0
        self.warning_count = 0

    def pass_test(self,name,msg=""):
        self.results.append(AuditResult(name,"PASS",msg,0))
        self.pass_count += 1

    def fail_test(self,name,msg=""):
        self.results.append(AuditResult(name,"FAIL",msg,0))
        self.fail_count += 1

    def warning(self,name,msg=""):
        self.results.append(AuditResult(name,"WARNING",msg,0))
        self.warning_count += 1

    def run(self,name,func):

        start=time.perf_counter()

        try:
            func()
        except Exception:
            self.fail_test(
                name,
                traceback.format_exc(limit=1)
            )

        end=time.perf_counter()

        self.results[-1].elapsed=end-start

    def report(self):

        print("="*90)
        print("ISLAMICAI PRODUCTION AUDIT")
        print("="*90)

        for r in self.results:

            color=GREEN

            if r.status=="FAIL":
                color=RED

            if r.status=="WARNING":
                color=YELLOW

            print(f"{color}{r.status:<8}{RESET} {r.name:<40} {r.elapsed:.4f}s")

            if r.message:
                print("   ",r.message)

        total=self.pass_count+self.fail_count+self.warning_count

        score=max(
            0,
            100-(self.fail_count*5)-self.warning_count
        )

        print()
        print("="*90)
        print("TOTAL TESTS :",total)
        print("PASSED      :",self.pass_count)
        print("FAILED      :",self.fail_count)
        print("WARNINGS    :",self.warning_count)
        print("FINAL SCORE :",score,"/100")
        print("="*90)

    def close(self):
        self.db.close()


audit=ProductionAudit()

